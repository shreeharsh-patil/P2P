{
  "name": "Dr Doom — Private P2P Transfer",
  "short_name": "Dr Doom",
  "description": "Dr Doom — encrypted P2P file and text transfers",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#040b08",
  "theme_color": "#91ff5f",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "*/*"
          ]
        }
      ]
    }
  }
}
