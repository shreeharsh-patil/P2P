# Port for the local signaling/app server
PORT=4050

# Signaling endpoint used by the static client. Required when the client is
# hosted somewhere other than this repo's Node server; the build falls back to
# same-origin /ws otherwise.
# Example: wss://your-signaling-backend.example.com/ws
VITE_SIGNALING_URL=

# Comma-separated STUN/TURN URLs merged into the client ICE list (no
# credentials here — private TURN goes on the server instead, see below).
# Example: stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_ICE_SERVERS=

# Optional: allowed browser origins for the API/WS server (comma-separated).
# When empty, all origins are accepted (convenient for local development).
# Example: ALLOWED_ORIGINS=https://shree.example.com
ALLOWED_ORIGINS=

# Optional: custom TURN relay served by this backend (used by /api/ice-servers).
# coturn picks these up via docker-compose.yml; never commit real credentials.
# TURN_URL=turn:your-domain:3478
# TURN_USERNAME=shreeuser
# TURN_CREDENTIAL=change-me-at-random

# coturn (docker-compose) credentials. The app refuses to start without them.
TURN_USERNAME=shreeuser
TURN_CREDENTIAL=change-me-at-random
TURN_PUBLIC_HOST=localhost
TURN_REALM=localhost
