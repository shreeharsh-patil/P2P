# Signaling Server Port (Local)
PORT=4050

# Custom Production Signaling Server WebSocket URL (Required for Vercel / Netlify cloud hosting)
# Example: wss://your-signaling-backend.onrender.com/ws
VITE_SIGNALING_URL="wss://shree-signaling.onrender.com/ws"

# Optional STUN/TURN ICE Servers Configuration (comma-separated URLs)
VITE_ICE_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
